/******************************************************************************
this efficient way you can calculate any character
counting the frequency of character in the string using hashing
A2Z -> Hashing 1st lecture
*******************************************************************************/

#include <iostream>
using namespace std;

int main()
{
    string s;

    cout << "enter the string where you want to count the character : ";
    cin >> s;
    int hash[256] = {0}; // can store characters using their character codes..it is good
    for(int i = 0; i < s.size(); i++)
    {
        cout << "Character: " << s[i] << endl;
        cout << "Index: " << s[i] << endl;

        hash[s[i]]++;

        cout << "Frequency now: " << hash[s[i]] << endl;
        cout << endl;
    }
    int q;

    cout << "enter how many character you wannn count baby: ";
    cin >> q;

    while(q--)
    {
        char c;
        cin >> c;

        cout << "You asked for: " << c << endl;
        cout << "Answer: " << hash[c] << endl;
        cout << endl;
    }

    return 0;
}
