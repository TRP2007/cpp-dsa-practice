#include <iostream>
#include <map>
using namespace std;

int main()
{
    int n;
    cout<<"enter size of array ";
    cin>>n;
    int A[n];
    cout << "Enter array elements: ";
    for(int i=0;i<n;i++)
    {
        cin>>A[i];
    }
    map<int,int> mp;
    for(int i=0;i<n;i++)
    {
        mp[A[i]]++;
    }
    int q;
    cout<<"enter how muny no. frequncy you want to count";
    cin>>q;
    while(q--)
    {
        int number;
        cout << "Enter number: "<<endl;
        cin >> number;
        cout<<"frequncy of above no is: "<<mp[number];
        
    }

    return 0;
}
