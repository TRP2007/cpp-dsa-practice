//this is 2nd program from hashing lec of A TO z series of striver:
//counting the frequency of number from given array
#include <iostream>
using namespace std;

int main()
{
    int n;
    cin >> n;

    int A[n];

    for(int i = 0; i < n; i++)
    {
        cin >> A[i];
    }

    int number;
    cout<<"enter the number which frequency you want to count :"<<endl;
    cin >> number;

    int count = 0;

    for(int i = 0; i < n; i++)
    {
        if(A[i] == number)
        {
            count++;
        }
    }

    cout <<"so the frequency count of above no  is :"<< count <<endl;

    return 0;
}
